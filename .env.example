# GoDaddy Professional Email Credentials
PORT=5000

# For standard GoDaddy Email: smtpout.secureserver.net (Port 465)
# For GoDaddy Microsoft 365: smtp.office365.com (Port 587)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true

# Your GoDaddy Professional Email address
GODADDY_EMAIL=info@yourdomain.com

# Your GoDaddy Email Password
GODADDY_PASSWORD=your_email_password_here

# Recipient Email (where you want to receive inquiries)
RECIPIENT_EMAIL=info@yourdomain.com
